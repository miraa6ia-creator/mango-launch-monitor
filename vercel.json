{
  "version": 2,
  "builds": [
    {
      "src": "api/bot.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/bot",
      "dest": "api/bot.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/bot.js"
    }
  ],
  "crons": [
    {
      "path": "/api/bot?check=1",
      "schedule": "*/5 * * * *"
    }
  ]
}
