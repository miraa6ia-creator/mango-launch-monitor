# Telegram Bot Token from @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Chat/Channel IDs to send launch alerts to (comma-separated)
# Get your chat ID by messaging @userinfobot or adding the bot to a channel
ALERT_CHAT_IDS=-1001234567890,123456789

# Polling interval in seconds (default: 30)
POLL_INTERVAL_SECONDS=30

# Optional: only alert if market cap is above this (set 0 to disable)
MIN_MARKET_CAP_USD=0
